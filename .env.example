# Backend Configuration
FASTAPI_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/auto_video_editor
REDIS_URL=redis://redis:6379/0

# AI/ML Services
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
REPLICATE_API_TOKEN=your_replicate_token_here

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=auto-video-editor-uploads
AWS_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:8000
VITE_UPLOAD_MAX_SIZE=2147483648

# Remotion Video Rendering
REMOTION_OUTPUT_DIR=./outputs
REMOTION_CONCURRENCY=4
REMOTION_FRAME_RANGE=0,300
REMOTION_CODEC=h264
REMOTION_PIXEL_FORMAT=yuv420p

# Video Processing
MAX_VIDEO_DURATION=600
MAX_FILE_SIZE=5368709120
SUPPORTED_FORMATS=mp4,mov,avi,mkv

# Processing
FFMPEG_TIMEOUT=3600
PROCESSING_QUEUE_NAME=video_processing
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
