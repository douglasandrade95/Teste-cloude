# Backend Configuration
FASTAPI_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/auto_video_editor
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# AI/ML Services
# ---------------------------------------------------------------------------
# Você NÃO precisa preencher nada aqui: a tela "Integrações" do app salva as
# chaves criptografadas no cofre local. Estas variáveis são só um caminho
# alternativo (Docker, Replit Secrets, CI) — o cofre tem prioridade.
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
KIE_API_KEY=your_kie_key_here
REPLICATE_API_TOKEN=your_replicate_token_here
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Cofre de credenciais (criptografia das chaves)
# ---------------------------------------------------------------------------
# Onde o cofre criptografado fica. Fora do repositório de propósito.
AVE_VAULT_DIR=~/.autovideoeditor

# Chave de criptografia do cofre. Se ficar vazia, é gerada automaticamente em
# $AVE_VAULT_DIR/master.key (permissão 0600). Em servidor, defina aqui:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AVE_MASTER_KEY=

# Protege a tela de Integrações quando o backend não é local.
# Vazio = só localhost pode ler/alterar chaves.
AVE_ADMIN_TOKEN=
AVE_SETTINGS_ALLOW_REMOTE=false

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=auto-video-editor-uploads
AWS_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:8000
VITE_UPLOAD_MAX_SIZE=2147483648

# Video Processing
MAX_VIDEO_DURATION=600
MAX_FILE_SIZE=5368709120
SUPPORTED_FORMATS=mp4,mov,avi,mkv

# Processing
FFMPEG_TIMEOUT=3600
PROCESSING_QUEUE_NAME=video_processing
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
